# Google Cloud Storage
GCS_BUCKET=your-gcs-bucket-name
GCS_PREFIX=twitter/raw

# Path to GCS service account JSON (or use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Twitter accounts pool — format: username:password:email:email_password
# Add multiple accounts separated by commas to increase throughput
TWITTER_ACCOUNTS=user1:pass1:email1@gmail.com:emailpass1,user2:pass2:email2@gmail.com:emailpass2

# Scraping params
MAX_TWEETS_PER_QUERY=500
MIN_LIKES=0
INCLUDE_RETWEETS=false

# Task: sentiment | stance | all
TASK=all
